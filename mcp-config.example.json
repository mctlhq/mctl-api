{
  "_comment_gemini": "Gemini CLI (~/.gemini/settings.json) — Streamable HTTP",
  "mcpServers": {
    "mctl": {
      "httpUrl": "https://api.mctl.ai/mcp",
      "headers": {
        "Authorization": "Bearer <your-github-token>"
      },
      "trust": true
    }
  },

  "_comment_claude": "Claude Desktop / Generic — Streamable HTTP",
  "mcpServers_claude": {
    "mctl": {
      "type": "http",
      "url": "https://api.mctl.ai/mcp",
      "headers": {
        "Authorization": "Bearer <your-github-token>"
      }
    }
  },

  "_comment_stdio": "stdio (local binary) — alternative",
  "mcpServers_stdio": {
    "mctl": {
      "command": "/path/to/mctl-mcp",
      "env": {
        "MCTL_API_URL": "https://api.mctl.ai"
      }
    }
  }
}

