{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/automation/v1/automation-definition.schema.json",
  "title": "AutomationDefinition (returned resource, standing intent only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant", "owner_principal", "created_by", "version", "state", "lifecycle", "template_id", "params", "trigger", "policies", "sync_state", "provenance", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "automation/v1"},
    "id": {"type": "string", "pattern": "^au_[0-9a-f-]{36}$"},
    "name": {"type": "string", "maxLength": 128},
    "tenant": {"type": "string", "minLength": 1},
    "owner_principal": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "actor": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "paused", "completed", "expired", "deleted"]},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fired_count"],
      "properties": {
        "expires_at": {"type": "string", "format": "date-time"},
        "max_fires": {"type": "integer", "minimum": 1},
        "fired_count": {"type": "integer", "minimum": 0}
      }
    },
    "template_id": {"type": "string"},
    "params": {"type": "object"},
    "trigger": {"$ref": "https://mctl.ai/schemas/automation/v1/trigger.schema.json"},
    "policies": {"$ref": "https://mctl.ai/schemas/automation/v1/policies.schema.json"},
    "sync_state": {"enum": ["pending", "applied", "failed"]},
    "sync_failure_reason": {"type": "string", "maxLength": 256},
    "policy_version": {"type": "string"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface"],
      "properties": {
        "surface": {"enum": ["oauth", "telegram", "portal"]},
        "origin_client_id": {"type": "string"},
        "link_id": {"type": "string", "pattern": "^sil_"}
      }
    },
    "replayed": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
