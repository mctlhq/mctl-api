{
  "contract": "glovo-facade-mctl-api",
  "version": "glovo-facade-mctl-api/v1alpha1",
  "base_path": "/api/v1/assistants/glovo/v1alpha1",
  "headers": {
    "authorization": "Authorization: Bearer <MCTL_GLOVO_FACADE_TOKEN>",
    "subject_token": "X-Mctl-Subject-Token",
    "selected_tenant": "X-Mctl-Selected-Tenant",
    "scope_ref": "X-Mctl-Scope-Ref",
    "idempotency_key": "Idempotency-Key",
    "request_id": "X-Request-Id",
    "replayed": "Idempotent-Replayed"
  },
  "routes": [
    {
      "id": "resolve",
      "method": "POST",
      "path": "/resolve",
      "scope": "any_glovo",
      "tool": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope_ref": {
            "type": "string",
            "pattern": "^gsc_[A-Za-z0-9_-]{32}$"
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "scope_ref",
          "tenant",
          "expires_at"
        ]
      },
      "needs_scope_ref": false,
      "idempotent": false
    },
    {
      "id": "connection",
      "method": "GET",
      "path": "/connection",
      "scope": "glovo:read",
      "tool": "glovo_auth_status",
      "request": null,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection_state": {
            "type": "string",
            "enum": [
              "none",
              "pending_handoff",
              "pending_provider",
              "active",
              "expired",
              "failed",
              "revoked"
            ]
          },
          "connection_id": {
            "type": "string"
          },
          "provider_account_label": {
            "type": "string",
            "maxLength": 80
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "connection_state"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": false
    },
    {
      "id": "connect",
      "method": "POST",
      "path": "/connections",
      "scope": "glovo:basket:prepare",
      "tool": "glovo_connect_account",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "idempotency_key"
        ]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending_handoff"
            ]
          },
          "handoff_url": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "connection_id",
          "state",
          "handoff_url",
          "expires_at"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": true
    },
    {
      "id": "orders",
      "method": "POST",
      "path": "/orders:list",
      "scope": "glovo:read",
      "tool": "glovo_get_order_history",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": []
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "orders": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "order_ref": {
                  "type": "string"
                },
                "store_name": {
                  "type": "string",
                  "maxLength": 120
                },
                "placed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "total_label": {
                  "type": "string",
                  "maxLength": 40
                },
                "item_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "order_ref",
                "store_name",
                "placed_at",
                "total_label",
                "item_count"
              ]
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "orders"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": false
    },
    {
      "id": "preview",
      "method": "POST",
      "path": "/previews",
      "scope": "glovo:read",
      "tool": "glovo_preview_reorder",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order_ref": {
            "type": "string"
          }
        },
        "required": [
          "order_ref"
        ]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preview_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "name",
                "quantity"
              ]
            }
          },
          "unavailable_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "name",
                "quantity"
              ]
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "preview_id",
          "items",
          "unavailable_items",
          "fingerprint",
          "expires_at"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": false
    },
    {
      "id": "basket",
      "method": "GET",
      "path": "/basket",
      "scope": "glovo:read",
      "tool": "glovo_get_basket",
      "request": null,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "store_name": {
            "type": "string",
            "maxLength": 120
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "name",
                "quantity"
              ]
            }
          },
          "totals_label": {
            "type": "string",
            "maxLength": 40
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "totals_label",
          "fingerprint"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": false
    },
    {
      "id": "prepare",
      "method": "POST",
      "path": "/orders:prepare",
      "scope": "glovo:basket:prepare",
      "tool": "glovo_prepare_order",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preview_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "preview_id",
          "idempotency_key"
        ]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "consent_request_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "order_id",
          "fingerprint",
          "consent_request_id",
          "expires_at"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": true
    },
    {
      "id": "order",
      "method": "GET",
      "path": "/orders/{order_id}",
      "scope": "glovo:read",
      "tool": "glovo_order_status",
      "request": null,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "OUTCOME_UNKNOWN",
              "observed_placed"
            ]
          }
        },
        "required": [
          "state",
          "outcome"
        ]
      },
      "needs_scope_ref": true,
      "idempotent": false
    },
    {
      "id": "compatibility",
      "method": "GET",
      "path": "/compatibility",
      "scope": "facade_identity",
      "tool": null,
      "request": null,
      "response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "contract_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "api_version": {
            "type": "string"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "connection_registry": {
                "type": "string",
                "enum": [
                  "ready",
                  "not_ready"
                ]
              },
              "provider_orders": {
                "type": "string",
                "enum": [
                  "ready",
                  "not_ready"
                ]
              },
              "read_bridge": {
                "type": "string",
                "enum": [
                  "ready",
                  "not_ready"
                ]
              },
              "control_worker": {
                "type": "string",
                "enum": [
                  "ready",
                  "not_ready"
                ]
              },
              "provider_worker": {
                "type": "string",
                "enum": [
                  "ready",
                  "not_ready"
                ]
              }
            },
            "required": [
              "connection_registry",
              "provider_orders",
              "read_bridge",
              "control_worker",
              "provider_worker"
            ]
          },
          "deploy_ready": {
            "type": "boolean"
          }
        },
        "required": [
          "contract_version",
          "contract_digest",
          "api_version",
          "dependencies",
          "deploy_ready"
        ]
      },
      "needs_scope_ref": false,
      "idempotent": false
    }
  ],
  "errors": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "enum": [
