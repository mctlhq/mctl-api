            "dependency_unavailable",
            "fingerprint_changed",
            "idempotency_key_reused",
            "invalid_arguments",
            "rate_limited"
          ]
        },
        "error_description": {
          "type": "string"
        }
      },
      "required": [
        "error",
        "error_description"
      ]
    },
    "facade_codes": [
