  "idempotency": {
    "key_pattern": "^[\\x21-\\x7e]{1,128}$",
    "header_and_body_must_match": true,
    "replay": "same key and body returns the first answer byte for byte with Idempotent-Replayed: true; the same key with another body is 409 idempotency_key_reused; the same key from another owner or tenant is independent",
    "exception": "POST /connections replays the same connection_id with a freshly minted handoff_url"
  },
  "limits": {
    "per_subject_per_minute": 60,
    "writes_per_subject_per_minute": 10,
    "facade_aggregate_per_minute": 600,
    "retry_after_header": true
  },
  "timeouts": {
    "request_seconds": 5
  },
  "oauth_resource_metadata": {
    "resource": "https://glovo.mctl.ai/mcp",
    "scopes_supported": [
      "glovo:read",
      "glovo:basket:prepare"
    ],
    "bearer_methods_supported": [
      "header"
    ]
  },
