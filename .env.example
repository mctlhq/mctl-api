# mctl-api configuration
# Copy to .env and fill in your values

PORT=8080
AUTH_REQUIRED=false

GITOPS_REPO_URL=https://github.com/your-org/your-gitops-repo.git
GITOPS_LOCAL_PATH=/tmp/mctl-gitops
# Overrides the embedded default known_hosts file used to verify GitHub's SSH host key when GITOPS_SSH_KEY_PATH is set. Test/local-dev only; production uses the shipped default.
# GITOPS_SSH_KNOWN_HOSTS_PATH=
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=
ARGO_WORKFLOWS_NAMESPACE=argo-workflows
GITHUB_ORG=your-org
ADMIN_USERS=
DEX_ISSUER_URL=https://dex.example.com/api/dex
DEX_CLIENT_ID=
SELF_URL=http://localhost:8080
BACKSTAGE_URL=
BACKSTAGE_TOKEN=
AUDIT_DB_URL=
# workitem/v1 store (/api/v1/work-items*); falls back to AUDIT_DB_URL.
# Any WORK_ITEMS_DISABLED value except false/f/0/no/off turns it off (routes answer 503).
WORK_ITEMS_DB_URL=
WORK_ITEMS_DISABLED=
# Roadmap publication (/api/v1/roadmap/*): a read-only clone of the public
# mctlhq/.github roadmap-state branch, refreshed every 5 minutes.
# Any ROADMAP_STATE_DISABLED value except false/f/0/no/off turns it off.
ROADMAP_STATE_REPO_URL=https://github.com/mctlhq/.github.git
ROADMAP_STATE_BRANCH=roadmap-state
ROADMAP_STATE_LOCAL_PATH=/tmp/roadmap-state
ROADMAP_STATE_TOKEN=
ROADMAP_STATE_DISABLED=
# Wave execution (/api/v1/roadmap/waves/execute): the latest publication may be
# at most this old (Go duration, default 30m); invalid turns execution off.
ROADMAP_WAVE_MAX_AGE=
# Surface identity links (/api/v1/surface-identities*, mctl-api#350); falls
# back to AUDIT_DB_URL. Each surface has its own token (>= 32 chars), never
# equal to MCTL_AGENT_SERVICE_TOKEN or to another surface's.
SURFACE_IDENTITY_DB_URL=
SURFACE_LINK_TTL=
SURFACE_IDENTITY_DISABLED=
MCTL_SURFACE_TELEGRAM_TOKEN=
MCTL_SURFACE_PORTAL_TOKEN=
MCTL_USAGE_WRITER_TOKEN=
# Durable execution-evidence store (/api/v1/evidence*, GET
# /api/v1/work-items/{id}/evidence, mctl-api#409); falls back to
# AUDIT_DB_URL. Any EVIDENCE_DISABLED value except false/f/0/no/off turns it
# off (routes answer 503). EVIDENCE_RETENTION_DAYS unset or 0 retains
# evidence indefinitely; the evidence writer's token follows the same rules
# as MCTL_USAGE_WRITER_TOKEN (>= 32 chars, never equal to another token).
EVIDENCE_DB_URL=
EVIDENCE_DISABLED=
EVIDENCE_RETENTION_DAYS=
MCTL_EVIDENCE_WRITER_TOKEN=
# Registry-publisher principal (mctlhq/mctl-agents#470): may only create an
# agent definition, publish a version and promote or roll back a release.
# Same rules as MCTL_USAGE_WRITER_TOKEN (>= 32 chars, never equal to another
# token). Unset: the principal is disabled and only admins can publish.
MCTL_REGISTRY_PUBLISHER_TOKEN=
LOKI_URL=
# HMAC secret for POST /api/v1/workflows/events/argo-complete (fail-closed if unset).
ARGO_WEBHOOK_SECRET=
# Inbound events (mctlhq/.github#87): HMAC secret for POST /api/v1/webhooks/github
# (fail-closed if unset), owners to accept, producer Valkey ACL URL and password,
# and the outbox database (falls back to AUDIT_DB_URL).
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_OWNERS=mctlhq
EVENTS_VALKEY_URL=
EVENTS_VALKEY_PASSWORD=
EVENTS_DB_URL=
# Optional RFC 7591 initial access token for POST /oauth/register.
OAUTH_REGISTRATION_TOKEN=
