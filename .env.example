# mctl-api configuration
# Copy to .env and fill in your values

PORT=8080
AUTH_REQUIRED=false

GITOPS_REPO_URL=https://github.com/your-org/your-gitops-repo.git
GITOPS_LOCAL_PATH=/tmp/mctl-gitops
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=
ARGO_WORKFLOWS_NAMESPACE=argo-workflows
GITHUB_ORG=your-org
ADMIN_USERS=
DEX_ISSUER_URL=https://dex.example.com/api/dex
DEX_CLIENT_ID=
SELF_URL=http://localhost:8080
BACKSTAGE_URL=
BACKSTAGE_TOKEN=
AUDIT_DB_URL=
LOKI_URL=
# HMAC secret for POST /api/v1/workflows/events/argo-complete (fail-closed if unset).
ARGO_WEBHOOK_SECRET=
# Optional RFC 7591 initial access token for POST /oauth/register.
OAUTH_REGISTRATION_TOKEN=
